# Instalación local. Copiar a .env y generar un JWT_SECRET propio antes de arrancar.
# No guardar credenciales reales en este ejemplo ni en el repositorio.
PORT=4100
HOST=127.0.0.1

# Obligatorio: valor aleatorio de al menos 32 bytes. README incluye generador local.
JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_PHONE_TTL=900

# APR-77: orígenes exactos autorizados; el despliegue debe fijar sus dominios HTTPS.
AUTH_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# true por defecto. Solo para HTTP local: false + HOST loopback, nunca production.
AUTH_COOKIE_SECURE=false
# lax recomendado si frontend/API comparten sitio. none requiere Secure=true.
AUTH_COOKIE_SAME_SITE=lax

# Firebase Auth verifica el token telefónico obtenido por el cliente.
PHONE_VERIFICATION_REQUIRED=true
PHONE_AUTH_ALLOW_DEV_TOKEN=false
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# memory persiste en backend/.data/db.json. El arranque no carga semillas.
DATA_DRIVER=memory

# Opt-in solo para seed/smoke/dump: activarlo en cada comando local de prueba.
ALLOW_TEST_SEED=false
# PAES_DIR=../../datos-paes

# Proyecto dedicado para ensayar Firestore con datos de prueba.
# Con DATA_DRIVER=firestore, las fixtures exigen emulador loopback y demo-*.
GCLOUD_PROJECT=demo-aprueba-student
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Una instalación real configura su propio proyecto y credenciales por separado;
# las semillas de prueba están bloqueadas fuera del emulador local.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/privada/serviceAccount.json

# Stripe solo admite claves de prueba en este MVP. Dejarlas vacías para el
# recorrido local sin pagos. Requiere Firestore y webhook firmado para pagar.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_UNI_MONTHLY=
STRIPE_PRICE_UNI_YEARLY=
STRIPE_PRICE_ALL_MONTHLY=
STRIPE_PRICE_ALL_YEARLY=
STRIPE_PORTAL_CONFIGURATION_ID=
STUDENT_WEB_URL=http://localhost:5174
