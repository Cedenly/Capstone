# ── Puerto del API ──
PORT=4000

# ── JWT ──
# Define una clave aleatoria propia de al menos 32 caracteres en backend/.env.
JWT_SECRET=
JWT_ACCESS_TTL=900          # 15 min (segundos)
JWT_REFRESH_TTL=2592000     # 30 días (segundos)

# ── Firestore ──
# Proyecto de GCP / Firebase
GCLOUD_PROJECT=demo-aprueba-admin

# OPCIÓN A · Firestore REAL:
#   Apunta a un archivo de credenciales de cuenta de servicio.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# OPCIÓN B · Emulador local (no requiere credenciales de GCP):
#   Levanta el emulador con `npm run emulator` y descomenta:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Las semillas son opcionales y solo aceptan emulador loopback + proyecto demo-*.
# Activar explícitamente para el comando de prueba, nunca para el arranque normal.
ALLOW_TEST_SEED=false
# Contraseña local elegida por quien ejecuta admin:local (12 caracteres a 72 bytes).
LOCAL_ADMIN_PASSWORD=
